# ---- DataMove configuration ----
# Metadata database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/datamove

# Redis (job queue / webhook buffers)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API server
API_PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# AES-256 key: 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker
WORKER_CONCURRENCY=3
WORKER_ID=worker-1
SYNC_BATCH_SIZE=1000
MAX_RECORD_ERRORS=1000

# Scheduler
SCHEDULER_TICK_SECONDS=15

# Notifications (optional)
ALERT_WEBHOOK_URL=
SMTP_URL=

# Local data dirs
DATA_DIR=./data
